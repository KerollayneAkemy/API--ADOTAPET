@startuml
 title AdotaPet — Atividade: aprovar ou recusar solicitação
 skinparam shadowing false
 skinparam activity {
   BackgroundColor #EFF6FF
   BorderColor #2563EB
   DiamondBackgroundColor #FEF3C7
   DiamondBorderColor #D97706
   StartColor #16A34A
   EndColor #DC2626
 }

 start
 :Receber PATCH de aprovação ou recusa;
 :Validar JWT e carregar usuário;
 if (Token válido?) then (sim)
   :Abrir transação PostgreSQL;
   :Buscar animal da solicitação;
   :Bloquear linha do animal (FOR UPDATE);
   :Bloquear linha da solicitação (FOR UPDATE);
   if (Solicitação existe?) then (sim)
     if (Usuário ONG/ADMIN responsável?) then (sim)
       if (Solicitação pendente?) then (sim)
         if (Aprovar?) then (sim)
           if (Animal disponível?) then (sim)
             :Marcar solicitação APROVADA;
             :Marcar animal ADOTADO;
             :Recusar outros pedidos pendentes;
             :COMMIT;
           else (não)
             :ROLLBACK · conflito;
           endif
         else (não · recusar)
           :Marcar solicitação RECUSADA;
           :COMMIT;
         endif
       else (não)
         :ROLLBACK · conflito;
       endif
     else (não)
       :ROLLBACK · acesso negado;
     endif
   else (não)
     :ROLLBACK · não encontrado;
   endif
 else (não)
   :Responder 401 · token inválido ou expirado;
 endif
 stop
@enduml

flowchart LR
  client[Cliente]
  api[API NestJS / monólito modular]
  postgres[(PostgreSQL: dados relacionais + idempotência)]
  redis[(Redis: limite distribuído)]
  r2[(Cloudflare R2 privado: fotos)]
  tunnel[cloudflared Quick Tunnel opcional]
  client -->|HTTP JSON + JWT| api
  client -. HTTPS temporário .-> tunnel
  tunnel --> api
  api --> postgres
  api --> redis
  api --> r2

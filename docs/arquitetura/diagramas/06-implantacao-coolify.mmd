C4Deployment
  title Implantação · Hostinger VPS e Coolify

  Person(usuario, "Usuário", "Acessa a API e o Swagger pelo domínio HTTPS configurado.")
  System_Ext(r2, "Cloudflare R2", "Bucket privado de fotos, acessado pela API via S3.")

  Deployment_Node(hostinger, "VPS Hostinger", "Ubuntu 24.04") {
    Deployment_Node(docker, "Docker Engine", "Rede privada dos serviços") {
      Container(proxy, "Proxy HTTPS", "Proxy gerenciado pelo Coolify", "Recebe o domínio e encaminha as requisições à API.")
      Container(api, "AdotaPet API", "Container Docker · Node.js / NestJS", "Porta 3000; aplica migrações ao iniciar; health check em /api/health.")
      ContainerDb(postgres, "PostgreSQL", "Container / serviço conectado", "Armazena dados relacionais e operações idempotentes.")
      ContainerDb(redis, "Redis", "Container / serviço conectado", "Mantém os contadores do rate limiting.")
    }

    Deployment_Node(coolify, "Coolify", "Painel de implantação") {
      Container(coolify_ui, "Painel Coolify", "Aplicação de gerenciamento", "Configura e acompanha a implantação dos serviços.")
    }
  }

  Rel(usuario, proxy, "Acessa API e Swagger", "HTTPS · domínio configurado")
  Rel(proxy, api, "Encaminha tráfego ao serviço", "Rede Docker · HTTP")
  Rel(api, postgres, "Conecta pelo DATABASE_URL interno", "SQL · PostgreSQL")
  Rel(api, redis, "Conecta pelo REDIS_URL interno", "Redis")
  Rel(api, r2, "Faz upload e gera URL assinada", "S3 API · HTTPS")
  Rel(coolify_ui, api, "Configura build, variáveis e implantação", "Docker")
  Rel(coolify_ui, proxy, "Gerencia roteamento e TLS")


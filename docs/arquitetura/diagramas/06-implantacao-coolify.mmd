C4Deployment
  title Implantação · Hostinger VPS com Coolify

  Person(client, "Cliente", "Acessa o domínio público da API.")
  System_Ext(r2, "Cloudflare R2", "Bucket privado de fotos.")

  Deployment_Node(vps, "VPS Hostinger", "Ubuntu 24.04") {
    Deployment_Node(docker, "Docker Engine", "Rede privada do projeto") {
      Container(proxy, "Proxy reverso", "Gerenciado pelo Coolify", "Termina TLS e encaminha as requisições.")
      Container(api, "AdotaPet API", "Node.js · NestJS", "Porta interna 3000; migrações e health check.")
      ContainerDb(pg, "PostgreSQL", "Container ou serviço conectado", "Persistência relacional em volume/serviço durável.")
      ContainerDb(redis, "Redis", "Container ou serviço conectado", "Contadores de rate limit.")
      Container(coolify, "Coolify", "Painel de gerenciamento", "Build, variáveis, rede e estado dos serviços.")
    }
  }

  Rel(client, proxy, "HTTPS · domínio configurado")
  Rel(proxy, api, "HTTP na rede privada")
  Rel(api, pg, "SQL · DATABASE_URL")
  Rel(api, redis, "Redis · REDIS_URL")
  Rel(api, r2, "S3 API · upload e URL assinada")
  Rel(coolify, api, "Implanta e configura")

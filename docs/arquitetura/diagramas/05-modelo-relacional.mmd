erDiagram
  USERS ||--o{ ANIMALS : responsavel
  USERS ||--o{ APPLICATIONS : adota
  ANIMALS ||--o{ APPLICATIONS : recebe

  USERS {
    uuid id PK
    text name
    text email UK
    text password_hash
    text role
  }
  ANIMALS {
    uuid id PK
    text name
    text species
    text breed
    text sex
    text size
    text city
    char state
    integer age
    text description
    text status
    uuid ong_id FK
    text_array photos
  }
  APPLICATIONS {
    uuid id PK
    uuid animal_id FK
    uuid adopter_id FK
    text reason
    text status
    timestamptz created_at
  }
  IDEMPOTENCY_KEYS {
    text scope_key PK
    text idempotency_key PK
    char request_hash
    integer response_status
    jsonb response
    timestamptz created_at
  }

  %% Restricoes parciais do PostgreSQL implementadas na migracao 001:
  %% um pedido PENDENTE por adotante/animal e uma APROVADA por animal.
  %% Checks validam papeis, status e idade; FKs impedem orfaos.

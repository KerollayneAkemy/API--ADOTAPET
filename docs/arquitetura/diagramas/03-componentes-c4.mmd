flowchart TB
  client[Cliente HTTP]
  subgraph app[Monólito modular NestJS]
    controllers[Controllers + DTOs]
    services[Serviços de aplicação]
    observability[Request context + Problem Details + JSON logger]
    persistence[DatabaseService + migrações]
    limiter[RateLimitGuard]
    storage[R2StorageService]
    controllers --> services
    services --> persistence
    controllers --> observability
    services --> observability
    services --> storage
    controllers --> limiter
  end
  pg[(PostgreSQL)]
  redis[(Redis)]
  r2[(R2 privado)]
  client --> controllers
  persistence --> pg
  limiter --> redis
  storage --> r2

C4Component
  title C3 · Componentes internos da API AdotaPet

  Person(cliente, "Cliente HTTP", "Envia requisições para a API.")
  ContainerDb(postgres, "PostgreSQL", "Banco relacional", "Persistência, transações, migrações e respostas idempotentes.")
  ContainerDb(redis, "Redis", "Cache de contadores", "Rate limiting distribuído entre instâncias.")
  System_Ext(r2, "Cloudflare R2", "Bucket privado para fotos de animais.")

  Container_Boundary(api, "API AdotaPet · NestJS") {
    Component(rate_limit, "RateLimitGuard", "NestJS Guard + Redis", "Aplica limite global por endereço IP; falha fechada quando Redis não responde.")
    Component(http, "Controllers e DTOs", "NestJS / class-validator", "Expõe rotas, valida entradas e conecta requisições aos serviços.")
    Component(auth, "Autenticação", "AuthService + AuthGuard", "Cadastro, login, hash de senha, JWT e carregamento do usuário atual.")
    Component(animals, "Animais", "AnimalsService", "Cadastro, consulta, filtros, autorização do responsável e fotos.")
    Component(applications, "Solicitações de adoção", "ApplicationsService", "Criação de pedidos e decisões transacionais com bloqueio por animal.")
    Component(idempotency, "Idempotência", "IdempotencyService", "Canonicaliza o corpo, compara SHA-256 e persiste/responde a chave repetida.")
    Component(database, "Acesso a dados", "DatabaseService + pg", "Pool PostgreSQL, transações e migrações no início da aplicação.")
    Component(storage, "Fotos", "R2StorageService + S3 SDK", "Valida conteúdo e tamanho, envia ao R2 e assina URLs temporárias.")
    Component(observability, "Observabilidade HTTP", "Middleware + filtro global", "Propaga Request-ID, registra logs JSON e converte exceções em Problem Details.")
  }


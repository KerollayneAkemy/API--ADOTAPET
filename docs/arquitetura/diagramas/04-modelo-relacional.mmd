erDiagram
  USERS ||--o{ ANIMALS : "responsavel ong_id"
  USERS ||--o{ APPLICATIONS : "adotante adopter_id"
  ANIMALS ||--o{ APPLICATIONS : "recebe animal_id"

  USERS {
    uuid id PK
    varchar_120 name
    varchar_254 email UK
    varchar_256 password_hash
    varchar_12 role "ADMIN ONG ADOTANTE"
  }

  ANIMALS {
    uuid id PK
    varchar_120 name
    varchar_40 species
    varchar_120 breed
    varchar_20 sex
    varchar_20 size
    varchar_120 city
    char_2 state
    integer age
    text description
    varchar_12 status "DISPONIVEL ADOTADO"
    uuid ong_id FK
    text_array photos
  }

  APPLICATIONS {
    uuid id PK
    uuid animal_id FK
    uuid adopter_id FK
    varchar_3000 reason
    varchar_12 status "PENDENTE APROVADA RECUSADA"
    timestamptz created_at
  }

  IDEMPOTENCY_KEYS {
    text scope_key PK
    varchar_128 idempotency_key PK
    char_64 request_hash
    integer response_status
    jsonb response
    timestamptz created_at
  }

  %% Chave primária composta: (scope_key, idempotency_key). A tabela não possui FK de usuário.
  %% Índices parciais impedem mais de um pedido pendente por adotante/animal e mais de uma aprovação por animal.
  %% CHECKs restringem papéis, status e idade; schema_migrations registra as migrações aplicadas.

erDiagram
  USERS ||--o{ ANIMALS : "ong_id · responsável"
  USERS ||--o{ APPLICATIONS : "adopter_id · adotante"
  ANIMALS ||--o{ APPLICATIONS : "animal_id · pedidos"

  USERS {
    uuid id PK
    varchar name
    varchar email UK
    varchar password_hash
    varchar role "ADMIN | ONG | ADOTANTE"
  }

  ANIMALS {
    uuid id PK
    varchar name
    varchar species
    varchar breed
    varchar sex
    varchar size
    varchar city
    char state
    integer age
    text description
    varchar status "DISPONIVEL | ADOTADO"
    uuid ong_id FK
    text_array photos "IDs dos objetos R2"
  }

  APPLICATIONS {
    uuid id PK
    uuid animal_id FK
    uuid adopter_id FK
    varchar reason
    varchar status "PENDENTE | APROVADA | RECUSADA"
    timestamptz created_at
  }

  IDEMPOTENCY_KEYS {
    text scope_key PK
    varchar idempotency_key PK
    char(64) request_hash
    integer response_status
    jsonb response
    timestamptz created_at
  }

  %% O par (scope_key, idempotency_key) identifica cada operação durável.
  %% Índices parciais permitem um pedido pendente por adotante/animal e uma aprovação por animal.
  %% A tabela de migrações é infraestrutura interna, não dado de domínio.
